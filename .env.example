# Fyers API credentials — copy to `.env` and fill in.
# Create an app at https://myapi.fyers.in/dashboard/ to get APP_ID and SECRET_ID.
FYERS_APP_ID=XXXXXXXXXX-100
FYERS_SECRET_ID=XXXXXXXXXX

# Redirect URI configured on your Fyers app (used during the OAuth login flow).
FYERS_REDIRECT_URI=https://127.0.0.1:5000/callback

# Access token — regenerate daily via `uv run scripts/fyers_auth.py` (expires each day).
FYERS_ACCESS_TOKEN=

# --- Intraday scalping params (override defaults in config/settings.py) ---
QT_BAR_RESOLUTION=5        # bar size in minutes for the scanner
QT_BREAKOUT_LOOKBACK=12    # break the high of the last N bars to enter long
QT_VOLUME_MULT=1.5         # require volume > 1.5x average to confirm breakout
QT_TAKE_PROFIT=0.004       # +0.4% target
QT_STOP_LOSS=0.002         # -0.2% stop
QT_MAX_HOLD_BARS=6         # time-stop: exit after N bars if flat
QT_SQUARE_OFF=15:15        # force-close everything at this IST time
QT_INITIAL_CAPITAL=1000000

# --- Intraday risk ---
QT_MAX_POSITIONS=5         # max concurrent open positions
QT_CAPITAL_PER_TRADE=0.10  # 10% of NAV per trade
QT_MAX_TRADES_PER_DAY=40
QT_DAILY_LOSS_LIMIT=0.03   # halt trading at -3% NAV on the day
